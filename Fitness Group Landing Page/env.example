# ─────────────────────────────────────────────────────────────
# Fit Explorers — Auto-notification configuration
# Copy this file to `.env` and fill in the values you want to use.
# Real providers are only called when the matching keys are present;
# otherwise the server logs a "dry-run" of the message instead.
#
#   cp env.example .env
# ─────────────────────────────────────────────────────────────

# Who should receive the notifications (defaults match src/config/site.ts)
ADMIN_EMAIL=osurejerhome@gmail.com
ADMIN_WHATSAPP=254797492910

# Port for the standalone API server (pnpm api). Dev uses the Vite server.
NOTIFY_PORT=8787

# Optional: where the browser should POST /api/contact in production.
# Leave empty when the API is served on the same origin (dev / reverse proxy).
# VITE_API_BASE_URL=https://your-api.example.com

# ─────────────────────────────────────────────────────────────
# EMAIL — SMTP (recommended, works with Gmail app passwords)
# ─────────────────────────────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=osurejerhome@gmail.com
#   SMTP_PASS=your-16-char-app-password   (enable 2FA -> create App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on the email (must be allowed by the SMTP account)
MAIL_FROM="Fit Explorers Website <osurejerhome@gmail.com>"

# ─────────────────────────────────────────────────────────────
# EMAIL — alternative: Resend HTTP API (https://resend.com)
# ─────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=Fit Explorers <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────
# WHATSAPP — Twilio WhatsApp Cloud API (https://www.twilio.com/whatsapp)
# ─────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   (Twilio sandbox/approved number)

# ─────────────────────────────────────────────────────────────
# WHATSAPP — alternative: generic webhook / other provider
# (e.g. Green API, 360dialog, Meta Cloud API proxy). The server POSTs
# JSON { to: "whatsapp:+<number>", text: "..." } to this URL.
# ─────────────────────────────────────────────────────────────
# WHATSAPP_WEBHOOK_URL=https://provider.example.com/messages
