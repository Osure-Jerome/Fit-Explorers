# ═════════════════════════════════════════════════════════════
# Fit Explorers — Auto-notification configuration
#
#   1. Copy this file:  cp env.example .env
#   2. Fill in ONE email option and ONE WhatsApp option.
#   3. Verify:          npm run notify:check
#      Live test:       npm run notify:test
#
# Channels with no credentials fall back to "dry-run" (the message is
# printed to the server log instead of being sent), so nothing crashes.
# ═════════════════════════════════════════════════════════════

# ── Who receives the notifications (defaults match src/config/site.ts) ──
ADMIN_EMAIL=osurejerhome@gmail.com
ADMIN_WHATSAPP=254797492910

# Port for the standalone API (`npm run api`). Dev uses the Vite server.
NOTIFY_PORT=8787

# Where the browser POSTs in production. Leave empty when the API is on the
# same origin (dev / reverse proxy); set it when the API is hosted separately.
# VITE_API_BASE_URL=https://your-notify-api.example.com


# ═════════════════════════════════════════════════════════════
# TWILIO — one account can power BOTH WhatsApp and email
# ═════════════════════════════════════════════════════════════

# ── WhatsApp (Twilio Messaging) ──
# Find SID + token in the Twilio Console dashboard (Account Info).
# TWILIO_WHATSAPP_FROM must be a WhatsApp-enabled Twilio sender.
# Trial accounts: first join the WhatsApp sandbox from the admin's phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Email (Twilio SendGrid, included with Twilio) ──
# Create a SendGrid API key with "Mail Send" permission, and verify the
# sender address/domain under SendGrid → Settings → Sender Authentication.
SENDGRID_API_KEY=
MAIL_FROM="Fit Explorers <your-verified-sender@example.com>"


# ═════════════════════════════════════════════════════════════
# ALTERNATIVES (optional — only needed if not using Twilio)
# ═════════════════════════════════════════════════════════════
# Email via SMTP (e.g. Gmail app password) — highest priority when set.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=osurejerhome@gmail.com
#   SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email via Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# WhatsApp via a generic webhook (Green API, 360dialog, custom gateway).
# The server POSTs JSON: { "to": "whatsapp:+254...", "text": "..." }
# WHATSAPP_WEBHOOK_URL=https://provider.example.com/messages
